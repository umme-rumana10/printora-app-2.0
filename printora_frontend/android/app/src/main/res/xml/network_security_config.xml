<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows HTTP (cleartext) traffic to localhost and LAN IPs during development.
  In production, remove the local IP entries and keep only HTTPS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android emulator localhost -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- iOS Simulator / physical device local network -->
        <domain includeSubdomains="false">localhost</domain>
        <!-- LAN: add your PC IP here, e.g. 192.168.1.5 -->
        <domain includeSubdomains="false">192.168.1.5</domain>
    </domain-config>
</network-security-config>
